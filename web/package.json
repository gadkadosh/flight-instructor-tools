{
  "name": "fitools-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && cp ../examples/sessions.json ../.dev-sessions.json && concurrently --kill-others \"go -C .. run . serve --port 8080 --no-open --sessions .dev-sessions.json --config examples/config.json\" \"vp dev\"",
    "build": "pnpm run check && vp build",
    "check": "vp check --deny-warnings",
    "format": "vp fmt",
    "test": "vp test run",
    "test:e2e": "node --test e2e/smoke.ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "concurrently": "^10.0.7",
    "playwright": "^1.65.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
