<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <title>Rechnung {{.Number}}</title>
  <style>
    @page {
      size: A4;
      margin: 0;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      color: #111;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 10pt;
      line-height: 1.3;
    }

    body {
      background: #eee;
    }

    .invoice {
      position: relative;
      width: 210mm;
      min-height: 297mm;
      margin: 0 auto;
      padding: 18mm 18mm 15mm;
      background: white;
    }

    .issuer {
      min-height: 29mm;
      text-align: right;
    }

    .issuer-name {
      margin-bottom: 1mm;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 17pt;
      font-weight: bold;
    }

    .issuer-address,
    .customer,
    .footer {
      white-space: nowrap;
    }

    .address-line {
      display: block;
    }

    .recipient-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      min-height: 17mm;
    }

    .issue-date {
      padding-bottom: 1mm;
      text-align: right;
    }

    h1 {
      margin: 5mm 0 4mm;
      font-size: 15pt;
      line-height: 1.15;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 9pt;
    }

    col.date { width: 15%; }
    col.description { width: 40%; }
    col.quantity { width: 12%; }
    col.rate { width: 14%; }
    col.vat { width: 8%; }
    col.total { width: 11%; }

    th,
    td {
      padding: 1.5mm 1mm;
      vertical-align: top;
    }

    th {
      border-bottom: 0.3mm solid #777;
      font-weight: bold;
      text-align: left;
    }

    th:first-child,
    td:first-child {
      padding-left: 1mm;
    }

    th:last-child,
    td:last-child {
      padding-right: 1mm;
    }

    .number {
      text-align: right;
      white-space: nowrap;
    }

    .vat {
      text-align: center;
      white-space: nowrap;
    }

    tbody tr:first-child td {
      padding-top: 2.2mm;
    }

    tbody tr:last-child td {
      padding-bottom: 2.2mm;
    }

    tfoot {
      border-top: 0.3mm solid #777;
      font-weight: bold;
    }

    tfoot td {
      padding-top: 1.6mm;
      padding-bottom: 1.6mm;
    }

    tfoot tr + tr td {
      padding-top: 0;
    }

    .closing {
      margin-top: 4mm;
      line-height: 1.45;
    }

    .closing p {
      margin: 0 0 5mm;
    }

    .signature {
      display: block;
      width: 36mm;
      height: auto;
      margin-bottom: 2mm;
    }

    .footer {
      position: absolute;
      right: 18mm;
      bottom: 11mm;
      left: 18mm;
      text-align: center;
      font-size: 8pt;
      line-height: 1.35;
    }

    @media print {
      body {
        background: white;
      }

      .invoice {
        margin: 0;
      }

      thead {
        display: table-header-group;
      }
    }
  </style>
</head>
<body>
  <main class="invoice">
    <header class="issuer">
      <div class="issuer-name">{{.Issuer.Name}}</div>
      <div class="issuer-address">
        {{range .Issuer.AddressLines}}<span class="address-line">{{.}}</span>{{end}}
        <span class="address-line">{{.Issuer.Email}}</span>
      </div>
    </header>

    <section class="recipient-row">
      <div class="customer">
        <strong>{{.Customer.Name}}</strong>
        {{range .Customer.AddressLines}}<span class="address-line">{{.}}</span>{{end}}
      </div>
      <div class="issue-date">{{formatLongDate .IssueDate}}</div>
    </section>

    <h1>Rechnung Nr. {{.Number}}</h1>

    <table>
      <colgroup>
        <col class="date">
        <col class="description">
        <col class="quantity">
        <col class="rate">
        <col class="vat">
        <col class="total">
      </colgroup>
      <thead>
        <tr>
          <th>Datum</th>
          <th>Schüler, Beschreibung</th>
          <th class="number">Menge<br>(Zeit)</th>
          <th class="number">Einzelpreis</th>
          <th class="vat">MwSt</th>
          <th class="number">Gesamtpreis</th>
        </tr>
      </thead>
      <tbody>
        {{range .Lines}}
        <tr>
          <td>{{formatShortDate .Date}}</td>
          <td>{{.Description}}</td>
          <td class="number">{{formatDuration .Minutes}}</td>
          <td class="number">{{formatMoney .HourlyRateCents}}</td>
          <td class="vat">{{.VATRatePercent}} %</td>
          <td class="number">{{formatMoney .TotalCents}}</td>
        </tr>
        {{end}}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="3"></td>
          <td colspan="2">Nettobetrag</td>
          <td class="number">{{formatMoney .Totals.NetCents}}</td>
        </tr>
        <tr>
          <td colspan="3"></td>
          <td colspan="2">MwSt. 0%</td>
          <td class="number">{{formatMoney .Totals.VATCents}}</td>
        </tr>
        <tr>
          <td colspan="3"></td>
          <td colspan="2">Gesamtbetrag</td>
          <td class="number">{{formatMoney .Totals.GrossCents}}</td>
        </tr>
      </tfoot>
    </table>

    <section class="closing">
      <p>{{.PaymentText}}</p>
      <p>{{.VATStatement}}</p>
      <p>{{.ClosingText}}</p>
      {{if .SignatureBase64}}<img class="signature" src="data:image/png;base64,{{.SignatureBase64}}" alt="Unterschrift von {{.Issuer.Name}}">{{end}}
      <p>{{.Issuer.Name}}</p>
    </section>

    <footer class="footer">
      <div>{{.Issuer.Name}}</div>
      <div>Steuer-Nr. {{.TaxNumber}}</div>
      <div>IBAN: {{.BankDetails.IBAN}} · BIC: {{.BankDetails.BIC}}</div>
    </footer>
  </main>
</body>
</html>
